exports[`generate (template utterances) > matches the snapshot for the hotels and weather server 1`] = `
{
  "_generated": {
    "by": "alexa-skill-mcp-bridge generator",
    "notice": "Generated file. Do not edit by hand; run \`npm run generate\`.",
  },
  "examplePhrases": [
    "search hotels on tomorrow",
    "get weather city some city",
  ],
  "protocolVersion": "2025-11-25",
  "server": {
    "instructions": "This server searches hotels and reports typical weather in sixty-six cities: twenty-four in the United States, eighteen European metropoles, and twenty-four across Canada, Latin America, Asia, the Middle East, Africa and Oceania. Hotel search needs a destination, check-in and check-out dates, and the number of guests; if guests is missing the tool asks for it. Prices are per night, in the local currency where travellers expect it and in US dollars elsewhere. Data is fixed and illustrative.",
    "name": "hotels-and-weather",
    "version": "0.1.0",
  },
  "tools": [
    {
      "description": "Find hotels in a destination city for a date range. Returns up to three matches sorted by rating. Asks for the number of guests when it is not provided.",
      "elicitedArguments": [],
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "checkIn": {
            "description": "Check-in date, ISO 8601 (YYYY-MM-DD)",
            "type": "string",
          },
          "checkOut": {
            "description": "Check-out date, ISO 8601 (YYYY-MM-DD)",
            "type": "string",
          },
          "destination": {
            "description": "City to search in, e.g. Berlin",
            "type": "string",
          },
          "guests": {
            "description": "Number of guests, 1 to 6",
            "maximum": 6,
            "minimum": 1,
            "type": "integer",
          },
        },
        "required": [
          "destination",
          "checkIn",
          "checkOut",
        ],
        "type": "object",
      },
      "intent": "SearchHotelsIntent",
      "name": "search_hotels",
      "slots": [
        {
          "argument": "checkIn",
          "required": true,
          "slot": "checkIn",
          "slotType": "AMAZON.DATE",
        },
        {
          "argument": "checkOut",
          "required": true,
          "slot": "checkOut",
          "slotType": "AMAZON.DATE",
        },
        {
          "argument": "guests",
          "required": false,
          "slot": "guests",
          "slotType": "AMAZON.NUMBER",
        },
        {
          "argument": "destination",
          "required": true,
          "slot": "destination",
          "slotType": "AMAZON.SearchQuery",
        },
      ],
    },
    {
      "description": "Typical weather for one of sixty-six cities worldwide: conditions plus high and low in Celsius.",
      "elicitedArguments": [],
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "city": {
            "description": "City name, e.g. Hamburg",
            "type": "string",
          },
        },
        "required": [
          "city",
        ],
        "type": "object",
      },
      "intent": "GetWeatherIntent",
      "name": "get_weather",
      "slots": [
        {
          "argument": "city",
          "required": true,
          "slot": "city",
          "slotType": "AMAZON.SearchQuery",
        },
      ],
    },
  ],
}
`;

