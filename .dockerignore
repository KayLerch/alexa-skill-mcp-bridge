# Build context for packages/agent/Dockerfile is the repo root. Keep only what the image needs:
# the root manifests, core and agent sources, and every workspace's package.json (npm ci wants them).

# Your settings: not in the image, and not staged into cdk.out with the build context.
.env
.env.*
bridge.config.ts
**/*.pem

**/node_modules
**/dist
**/cdk.out
**/*.tsbuildinfo
**/*.test.ts
**/__snapshots__
.git
.github
spikes
docs
skill-package
scripts
*.md
**/README.md
infra/**
!infra/package.json
examples/**
!examples/*/package.json
packages/cli/**
!packages/cli/package.json
packages/generator/**
!packages/generator/package.json
packages/skill-lambda/**
!packages/skill-lambda/package.json
