# Copy to .env (git-ignored) and set what applies to you. Everything here overrides
# bridge.config.ts, so the tracked config file stays exactly as it ships and your own
# URL, secret name and Alexa Skill id never reach a commit.
#
# A real environment variable wins over this file, so CI and one-off runs still work:
#   BRIDGE_MCP_URL=https://staging.example.com/mcp npm run chat

# Everything below is commented out on purpose: copying this file changes nothing until you
# edit it, so `npm run chat` keeps working against the bundled sample server out of the box.

# Your MCP server's Streamable HTTP endpoint. Unset: the bundled sample on localhost:3939.
# The deployed agent runs in AWS, so device tests need a public URL (see the README).
#BRIDGE_MCP_URL=https://your-server.example.com/mcp

# MCP auth, when your server needs it: none | bearer | apiKey | oauthClientCredentials.
# BRIDGE_MCP_SECRET_NAME is the Secrets Manager secret *name*, never the value.
#BRIDGE_MCP_AUTH_TYPE=bearer
#BRIDGE_MCP_SECRET_NAME=alexa-mcp-bridge/mcp-token

# The secret *value*, for local runs only (npm run chat, npm run generate). In AWS the
# agent reads it from Secrets Manager instead. Keep real tokens in .env, nowhere else.
#MCP_SECRET_VALUE=the-token

# Written for you: `npm run deploy` stores the Lambda ARN here and `npm run skill:deploy` stores
# the Alexa Skill id. Both identify your account, which is why they live in .env, not in git.
#BRIDGE_LAMBDA_ARN=arn:aws:lambda:us-east-1:000000000000:function:AlexaMcpBridgeStack-SkillLambda
# With the id set, the next `npm run deploy` locks the Lambda to your Alexa Skill (recommended);
# without it any Alexa Skill that knows the ARN can invoke yours.
#BRIDGE_SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000

# Only us-east-1 has been verified.
#BRIDGE_AWS_REGION=us-east-1
